      "code": "import numpy as np\nfrom tslearn.early_classification import NonMyopicEarlyClassifier\nfrom tslearn.svm import TimeSeriesSVC\n\n# Initialize a base classifier and the early classifier\nbase_clf = TimeSeriesSVC(kernel=\"gak\", gamma=\"auto\", probability=True, random_state=42)\nearly_clf = NonMyopicEarlyClassifier(\n    n_clusters=2,\n    base_classifier=base_clf,\n    cost_time_parameter=1e-3,\n    random_state=42\n)\n\n# Fit the early classifier on the balanced dataset\nearly_clf.fit(X, y)\n\n# Predict probabilities and earliness for the second dataset\nprobas, earliness = early_clf.predict_proba_and_earliness(X2)\n\n# Verify the results\nassert probas.shape == (X2.shape[0], len(np.unique(y))), f\"Expected probas shape {(X2.shape[0], len(np.unique(y)))}, got {probas.shape}\"\nassert earliness.shape == (X2.shape[0],), f\"Expected earliness shape {(X2.shape[0],)}, got {earliness.shape}\"\nassert np.all(earliness >= 0) and np.all(earliness <= X2.shape[1]), \"Earliness must be between 0 and the length of the time series\"\nassert np.allclose(np.sum(probas, axis=1), 1.0), \"Probabilities must sum to 1 for each sample\"\n\nprint(f\"__CHECK__ predict_proba_and_earliness probas_shape={probas.shape} earliness_mean={np.mean(earliness):.2f}\")",
