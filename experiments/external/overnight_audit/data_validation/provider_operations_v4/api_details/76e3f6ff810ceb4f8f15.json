      "code": "from tslearn.utils import check_variable_length_input\nimport numpy as np\n\n# Create a variable-length input: a list of 1D arrays of different lengths\nvar_len_input = [s1[:10], s2[:20], s1[:30]]\n\n# check_variable_length_input pads the arrays to the maximum length and returns a 3D array\npadded_dataset = check_variable_length_input(var_len_input)\n\n# Verify the output shape: (n_ts, max_sz, d) -> (3, 30, 1)\nassert padded_dataset.shape == (3, 30, 1), f\"Expected shape (3, 30, 1), got {padded_dataset.shape}\"\n\n# Verify that padding was applied correctly (NaNs at the end of shorter series)\nassert np.isnan(padded_dataset[0, 10:, 0]).all(), \"Expected NaNs for padded values in the first series\"\nassert not np.isnan(padded_dataset[0, :10, 0]).any(), \"Expected no NaNs in the original part of the first series\"\n\nprint(f\"__CHECK__ check_variable_length_input shape {padded_dataset.shape}\")",
